# Server
PORT=4000
NODE_ENV=development
JWT_SECRET=change-me-super-secret
JWT_EXPIRES_IN=7d

# PostgreSQL
DATABASE_URL=postgres://errsight:errsight@localhost:5432/errsight
PGHOST=localhost
PGPORT=5432
PGUSER=errsight
PGPASSWORD=errsight
PGDATABASE=errsight

# Redis
REDIS_URL=redis://localhost:6379

# Rate limiting (ingestion)
INGEST_RATE_LIMIT_MAX=100
INGEST_RATE_LIMIT_WINDOW_MS=60000

# Alerts (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASS=change-me
ALERT_FROM_EMAIL=alerts@errsight.local

# Slack (optional)
SLACK_WEBHOOK_URL=

# Dashboard
DASHBOARD_ORIGIN=http://localhost:5173
